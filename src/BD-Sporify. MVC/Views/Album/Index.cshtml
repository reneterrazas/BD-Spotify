@using Spotify.Core
@model List<Album>

@{
    ViewData["Title"] = "Álbumes";
}

<div class="list-card">
    <h1>Listado de Álbumes</h1>

    <table class="table table-hover table-bordered table-success">
        <thead>
            <tr>
                <th>Titulo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var album in Model)
            {
                <tr>
                    <td><a asp-route-id="@album.idAlbum" asp-action="DetalleAlbum">@album.Titulo</a></td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-primary"><a asp-action="CreateAlbum">Crear Album</a></button>
</div>
