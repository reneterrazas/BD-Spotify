@using Spotify.Core
@model List<Album>

@{
    ViewData["Title"] = "Álbumes";
}

<div class="list-card">
    <h1>Listado de Álbumes</h1>

    <table class="table table-hover table-bordered table-success">
        <thead>
            <tr>
                <th>Titulo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var album in Model)
            {
                <tr>
                    <td>@album.Titulo</td>
                </tr>
            }
        </tbody>
    </table>
</div>
