@using Spotify.Core
@model CrearCancionViewModel

@{
    ViewData["Title"] = "Crear Cancion";
}

<div class="form-card">
    <h2>Alta de Cancion</h2>
    <form asp-action="CreateCancion" method="post">
        <div class="form-group">
            <label asp-for="@Model.Titulo">Titulo de la cancion</label>
            <input asp-for="@Model.Titulo" placeholder="Titulo" class="form-control"/>
        </div>
        <div class="form-group">
            <label>Album</label>
            <select asp-for="AlbumId" asp-items="@(new SelectList(Model.albums, "idAlbum", "Titulo"))">
                <option value="">-- Selecciona un Album --</option>
            </select>
        </div>
        <div class="form-group">
            <label>Genero</label>
            <select asp-for="GeneroId" asp-items="@(new SelectList(Model.generos, "idGenero", "genero"))">
                <option value="">-- Selecciona un Genero --</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Enviar</button>
    </form>
</div>
