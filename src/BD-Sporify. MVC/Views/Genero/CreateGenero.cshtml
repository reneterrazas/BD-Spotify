@using Microsoft.AspNetCore.Mvc.Rendering
@model Spotify.Core.Genero

@{
    ViewData["Title"] = "Crear Genero";
}

<div class="form-card">
    <h2>Alta de Genero</h2>
    <form asp-action="CreateGenero" method="post">
        <div class="form-group">
            <label asp-for="genero">Nombre del genero</label>
            <input asp-for="genero" placeholder="Nombre" class="form-control"/>
        </div>
        <button type="submit" class="btn btn-primary">Enviar</button>
    </form>
</div>
