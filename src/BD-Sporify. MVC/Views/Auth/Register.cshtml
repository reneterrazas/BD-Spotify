@model RegisterViewModel

<div class="container mt-5" style="max-width: 400px;">
    <h2 class="mb-4">Registrarse</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Register" method="post">
        <div class="mb-3">
            <label>Nombre</label>
            <input class="form-control" asp-for="Nombre" />
        </div>
        <div class="mb-3">
            <label>Email</label>
            <input class="form-control" asp-for="Email" />
        </div>
        <div class="mb-3">
            <label>Contraseña</label>
            <input type="password" class="form-control" asp-for="Contrasenia" />
        </div>
        <div class="mb-3">
            <label>Nacionalidad</label>
      <select class="form-control" asp-for="NacionalidadId" asp-items="Model.Nacionalidades">
        <option value="">-- Seleccione nacionalidad --</option>
    <select>
      </div>
        <div class="mb-3">
            <label>Confirmar Contraseña</label>
            <input type="password" class="form-control" asp-for="ConfirmarContrasenia" />
        </div>
        <button class="btn btn-success w-100" type="submit">Registrarse</button>
    </form>

    <p class="mt-3 text-center">
        ¿Ya tienes una cuenta? <a asp-action="Login">Inicia sesión</a>
    </p>
</div>