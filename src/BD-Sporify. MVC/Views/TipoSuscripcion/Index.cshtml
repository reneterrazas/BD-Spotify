@using Spotify.Core
@model List<TipoSuscripcion>

@{
    ViewData["Title"] = "TipoSuscripciones";
}

<div class="list-card">
    <h1>Listado de TiposSuscripciones</h1>

    <table class="table table-hover table-bordered table-success">
        <thead>
            <tr>
                <th>Nombre del tipo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tipoSuscripcion in Model)
            {
                <tr>
                    <td><a asp-route-id="@tipoSuscripcion.IdTipoSuscripcion" asp-action="DetalleTipoSuscripcion">@tipoSuscripcion.Tipo</a></td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-primary">
    <a asp-action="CreateTipoSuscripcion" class="text-white text-decoration-none">Crear TipoSuscripcion</a>
</button>

</div>
