<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BD_Sporify._MVC</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Tus estilos -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BD_Sporify._MVC.styles.css" asp-append-version="true" />
</head>

<body class="bg-dark text-white">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-success border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    🎵 BD-Spotify
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                    <!-- LINKS DEL MENÚ IZQUIERDO -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Artista" asp-action="Index">Artistas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Album" asp-action="Index">Álbumes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Genero" asp-action="Index">Géneros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Cancion" asp-action="Index">Canciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Nacionalidad" asp-action="Index">Nacionalidades</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                        </li>
                    </ul>

                    <!-- BOTÓN DE LOGIN A LA DERECHA -->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="btn btn-light text-dark fw-bold px-3" asp-controller="Auth" asp-action="Login">
                                Iniciar sesión
                            </a>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="sa container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-success text-center text-white py-3 mt-auto">
        <div class="container">
            <p class="mb-0">© 2025 BD-Spotify — Todos los derechos reservados 🎧</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    .sa {
        height: 612px;
    }
</style>
