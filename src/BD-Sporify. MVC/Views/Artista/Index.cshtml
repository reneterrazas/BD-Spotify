@using Spotify.Core
@model List<Artista>

@{
    ViewData["Title"] = "Artista";
}
<!-- Listado de Artistas -->
<div class="list-card">
    <h2>Listado de Artistas</h2>

    @if (Model != null && Model.Any())
    {
        <table class="table table-hover table-bordered table-success">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Nombre Artístico</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var artista in Model)
                {
                    <tr>
                        <td> @artista.idArtista</td>
                        <td><a asp-route-id="@artista.idArtista" asp-action="DetalleDeArtista">@artista.Nombre</a></td>
                        <td>@artista.Apellido</td>
                        <td>@artista.NombreArtistico</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No hay artistas cargados aún.</p>
    }
   <button type="button" class="btn btn-primary text-white">
    <a asp-action="CreateArtista" class="text-white text-decoration-none">Crear Artistas</a>
</button>

</div>
