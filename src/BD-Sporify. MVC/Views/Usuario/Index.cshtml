@using Spotify.Core
@model List<Usuario>

@{
    var usuarioLogueado = Context.Session.GetString("UsuarioLogueado");
    ViewData["Title"] = "Álbumes";
}

<div class="list-card">
    <h1>Listado de Usuarios</h1>

    <table class="table table-hover table-bordered table-success">
        <thead>
            <tr>
                <th>Nombre del usuario</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td><a asp-route-id="@usuario.idUsuario" asp-action="DetalleUsuario">@usuario.NombreUsuario</a></td>
                </tr>
            }
        </tbody>
    </table>
    @if (!string.IsNullOrEmpty(usuarioLogueado)){
    <button class="btn btn-primary">
    <a asp-action="CreateUsuario" class="text-white text-decoration-none">Crear Usuario</a>
</button>
    }
</div>
