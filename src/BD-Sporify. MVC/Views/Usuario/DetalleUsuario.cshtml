@using Spotify.Core
@model Usuario
@{
    ViewData["Title"] = "Detalle del Usuario";
}

<h1>@ViewData["Title"]</h1>


@if (Model != null)
{
    <div>
        <h2>Nombre del usuario: @Model.NombreUsuario</h2>
        <p>Email: @Model.Email</p>
        <p>Nacionalidad: @Model.nacionalidad.Pais</p>
    </div>
}
else
{
    <p>No se encontró información del Usuario.</p>
}
