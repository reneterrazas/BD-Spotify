@using Spotify.Core
@model ArtistaViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <form asp-action="Index" method="post">
        <h1>Alta Artista</h1>
        <div>
            <label asp-for="artista.Nombre">Nombre</label>
            <input asp-for="artista.Nombre" placeholder="Nombre" />
        </div>
        <div>
            <label asp-for="artista.Apellido">Apellido</label>
            <input asp-for="artista.Apellido" placeholder="Apellido">
        </div>
        <div>
            <label asp-for="artista.NombreArtistico">NombreArtistico</label>
            <input asp-for="artista.NombreArtistico" placeholder="Nombre artístico" />
        </div>
        <button type="submit">Enviar</button>
    </form>
    <h2>Lista de Artistas</h2>
    <ul>
        @foreach (Artista artista in Model.artistas)
        {
            <li>@artista.Nombre (@artista.NombreArtistico)</li>
        }
    </ul>
</div>
